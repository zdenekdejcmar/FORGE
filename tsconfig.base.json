{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@forge/domain": ["packages/domain/src/index.ts"],
      "@forge/validation": ["packages/validation/src/index.ts"],
      "@forge/db": ["packages/db/src/index.ts"]
    }
  }
}
